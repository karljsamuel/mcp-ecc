{
  "name": "@mcp-ecc/storage-sqlite",
  "version": "0.1.0",
  "description": "SQLite storage adapter for mcp-ecc",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../../core"
  },
  "optionalDependencies": {
    "better-sqlite3": "^9.6.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/crypto-js": "^4.2.0",
    "vitest": "^4.1.11",
    "eslint": "^10.9.1"
  }
}