{
  "name": "@mcp-ecc/storage-sqlite",
  "version": "0.6.0",
  "description": "SQLite storage adapter for mcp-ecc",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../../core",
    "crypto-js": "^4.2.0",
    "@types/crypto-js": "^4.2.0"
  },

  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.3",
    "@types/crypto-js": "^4.2.0",
    "vitest": "^4.1.11",
    "eslint": "^10.11.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
