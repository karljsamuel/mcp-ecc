{
  "name": "@mcp-ecc/storage-d1",
  "version": "0.4.0-beta.1",
  "description": "Cloudflare D1 storage adapter for mcp-ecc (Workers)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../../core",
    "crypto-js": "^4.2.0",
    "@types/crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.11",
    "eslint": "^10.9.1",
    "@cloudflare/workers-types": "^5.20260829.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}
