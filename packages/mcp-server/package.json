{
  "name": "@mcp-ecc/mcp-server",
  "version": "0.3.0",
  "description": "MCP Server for mcp-ecc",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../core",
    "@mcp-ecc/provider-google": "file:../providers/google",
    "@mcp-ecc/provider-microsoft": "file:../providers/microsoft",
    "@mcp-ecc/provider-zoho": "file:../providers/zoho",
    "@mcp-ecc/provider-imap-smtp": "file:../providers/imap-smtp",
    "@mcp-ecc/provider-caldav": "file:../providers/caldav",
    "@mcp-ecc/provider-carddav": "file:../providers/carddav",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.11",
    "eslint": "^10.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "MIT"
}