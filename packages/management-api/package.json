{
  "name": "@mcp-ecc/management-api",
  "version": "0.7.0",
  "description": "Management API for mcp-ecc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-ecc-api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../core",
    "@mcp-ecc/mcp-server": "file:../mcp-server",
    "@mcp-ecc/storage-sqlite": "file:../storage/sqlite",
    "@mcp-ecc/storage-d1": "file:../storage/d1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.8",
    "@fastify/websocket": "^11.3.7",
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "@fastify/cookie": "^11.1.2",
    "dotenv": "^18.0.9",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "vitest": "^5.0.5",
    "eslint": "^10.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "license": "MIT"
}
