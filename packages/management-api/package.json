{
  "name": "@mcp-ecc/management-api",
  "version": "0.1.0",
  "description": "Management API for mcp-ecc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-ecc-api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../core",
    "@mcp-ecc/mcp-server": "file:../mcp-server",
    "@mcp-ecc/storage-sqlite": "file:../storage/sqlite",
    "@mcp-ecc/storage-memory": "file:../storage/memory",
    "@modelcontextprotocol/sdk": "^1.0.1",
    "fastify": "^4.28.0",
    "@fastify/websocket": "^8.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/static": "^7.0.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0"
  }
}