{
  "name": "@mcp-ecc/management-api",
  "version": "0.3.0",
  "description": "Management API for mcp-ecc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-ecc-api": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/bin.js",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../core",
    "@mcp-ecc/mcp-server": "file:../mcp-server",
    "@mcp-ecc/storage-sqlite": "file:../storage/sqlite",
    "@mcp-ecc/storage-memory": "file:../storage/memory",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.12.0",
    "@fastify/websocket": "^11.3.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/cookie": "^11.1.2",
    "dotenv": "^17.4.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "vitest": "^4.1.11",
    "eslint": "^10.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}