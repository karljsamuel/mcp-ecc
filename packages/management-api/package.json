{
  "name": "@mcp-ecc/management-api",
  "version": "0.1.0",
  "description": "Management API for mcp-ecc",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../core",
    "@mcp-ecc/mcp-server": "file:../mcp-server",
    "fastify": "^4.28.0",
    "@fastify/websocket": "^8.3.0",
    "@fastify/cors": "^9.0.0",
    "@fastify/static": "^7.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0"
  }
}