{
  "name": "@mcp-ecc/provider-imap-smtp",
  "version": "0.1.0",
  "description": "IMAP/SMTP provider for mcp-ecc",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "clean": "rm -rf dist .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-ecc/core": "file:../../core",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "@types/imap-simple": "^4.2.8",
    "@types/mailparser": "^3.4.4",
    "@types/nodemailer": "^6.4.15",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0"
  }
}