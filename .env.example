# mcp-ecc environment configuration
# Copy to .env and fill in the values you need. Never commit .env.

# === Required ===
# Master key used to encrypt stored credentials (AES-256-GCM).
# Generate with:  openssl rand -hex 32
MCP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# === Server ===
# Port and bind host for the single-container API (web UI + REST + MCP on one port)
PORT=3001
HOST=0.0.0.0
# Public base URL used for OAuth redirects (set to your host/IP when exposed)
BASE_URL=http://localhost:3001
# Persisted SQLite path inside the container
MCP_STORAGE_FILE=/data/mcp-ecc.db

# === Google (Gmail, Calendar, People/Contacts) ===
# From https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === Microsoft / Office 365 (Graph API) ===
# From https://portal.azure.com -> App registrations
MICROSOFT_CLIENT_ID=your-microsoft-application-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# Tenant ID for single-tenant / M365 org accounts. Leave unset for personal or 'common'.
# MICROSOFT_TENANT_ID=your-directory-tenant-id
# The legacy/compat alias if you set MICROSOFT_TENANT_ID:
MICROSOFT_TENANT_ID=

# === Zoho (Mail, Calendar, Contacts) ===
# From https://api-console.zoho.com
ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
# Optional: override the Zoho API region via account config (accounts.zoho.com, .eu, .in, ...).
