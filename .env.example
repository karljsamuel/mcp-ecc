# mcp-ecc environment configuration
# Copy to .env and fill in the values you need. Never commit .env.
#
# IMPORTANT: OAuth client IDs/secrets are stored PER-ACCOUNT (via the CLI or web UI),
# NOT here. This file only holds server-level settings.

# === Required ===
# Master key used to encrypt stored credentials (AES-256-GCM).
# Generate with:  openssl rand -hex 32
#
# The placeholder below is DELIBERATELY REFUSED by the server, as are
# 'default-secret-key' and similar values. The process will not start until you
# replace it with a real key; there is no fallback key of any kind. Run
# `mcp-ecc setup` (or open the web setup page) to have one generated for you.
MCP_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# === Server / networking ===
# PORT is what the API and MCP server actually listen on inside the container.
PORT=3001
# HOST_PORT is the host-side mapping read by docker-compose (the left side of
# "${HOST_PORT}:3001"). It does not affect the listener itself.
HOST_PORT=3001

# Bind address.
#   0.0.0.0  -> listen on all interfaces (default). Use when the container is
#              directly reachable.
#   127.0.0.1 -> loopback only. Use when a reverse proxy (Caddy/Nginx/Traefik),
#              Cloudflare Tunnel, or Tailscale runs in FRONT of this container
#              and terminates TLS / forwards traffic to it.
HOST=0.0.0.0

# Public base URL used for OAuth redirects and browser links.
# Set to your externally reachable URL, e.g.:
#   - http://localhost:3001                      (local only)
#   - https://mcp-ecc.your-tailnet.ts.net       (Tailscale)
#   - https://mcp-ecc.yourdomain.com            (Cloudflare Tunnel / reverse proxy)
PUBLIC_URL=http://localhost:3001

# Session-cookie signing secret (used for web UI + API sessions).
# Independent of MCP_ENCRYPTION_KEY, so rotating the master key no longer signs
# everyone out. Leave blank and one is generated on first run; set a fixed value
# if you want sessions to survive a restart or a move between hosts.
SESSION_SECRET=

# === Database Provider (SQLite or Cloudflare D1) ===
# MANDATORY — Choose your storage backend:
#   - sqlite — Local file-based storage.
#   - d1     — Hosted serverless database on Cloudflare (no local file needed).
MCP_DB_PROVIDER=sqlite

# --- SQLite Configuration (MANDATORY when MCP_DB_PROVIDER is "sqlite") ---
# Absolute path to your SQLite database file.
# Must be set when MCP_DB_PROVIDER=sqlite.
MCP_STORAGE_FILE=/data/mcp-ecc.db

# --- Cloudflare D1 Configuration (MANDATORY when MCP_DB_PROVIDER is "d1") ---
# These are ignored completely if MCP_DB_PROVIDER is set to "sqlite".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# === Optional: override the Docker image used by docker-compose ===
# MCP_ECC_IMAGE=ghcr.io/karljsamuel/mcp-ecc:beta