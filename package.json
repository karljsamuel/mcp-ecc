{
  "name": "mcp-ecc",
  "version": "0.5.1",
  "description": "MCP Server for Email, Calendar, and Contacts with Headless OAuth Support",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/storage/*",
    "packages/providers/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\"",
    "cli": "node packages/cli/dist/bin.js",
    "api": "node packages/management-api/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.10.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@10.8.0",
  "license": "MIT",
  "overrides": {
    "ip-address": "^10.7.0",
    "qs": "^6.16.0",
    "tar": "^7.5.22",
    "undici": "^8.10.2"
  }
}
